# Rust
/target/
**/*.rs.bk
*.pdb
# Cargo.lock IS committed: maapp ships a single binary and CI runs `--locked` for
# deterministic, reproducible builds. Do not ignore it.

# WASM build artifacts
/pkg/
*.wasm

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# Secrets — never commit
.env
*.key

# Scratch / local
/tmp/
*.local
