{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "maapp-graph",
  "title": "maapp graph document",
  "description": "Canonical JSON Schema for a maapp-graph document (schema version 1.4), generated by `maapp schema` from the engine's Rust vocabulary tables — the same tables `maapp validate` enforces (single source of truth; do not hand-edit). The canonical schema id is 'maapp-graph'; the engine also accepts any per-app '<app>-graph' id — that suffix acceptance is a compat rule, not canon. Selectional edge from/to kind sets are cross-node constraints JSON Schema cannot express; they are carried as x-maapp-fromKinds/x-maapp-toKinds annotations and enforced by `maapp validate` (E_KIND).",
  "type": "object",
  "required": [
    "schema",
    "version"
  ],
  "properties": {
    "attrEnumRegistry": {
      "type": "object",
      "description": "Declarative closed-enum extensions (open-with-registry): '<verb>.<attr>' (or '<Kind>.<attr>' for node attrs, e.g. 'Trigger.cause') → list of declared tokens. A non-core value in a closed-enum position is E_ATTR_ENUM (E_TRIGGER_CAUSE for Trigger.cause) unless declared here (data overlays, never code plugins). Namespace NEW tokens 'x-<ns>:token' (collision-safe against future core values); bare tokens are accepted for domain-specific vocabularies.",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "edgeRegistry": {
      "type": "object",
      "description": "Declarative edge-verb extensions: 'x-<ns>:verb' → row (data overlays, never code plugins).",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "family": {
            "type": "string"
          },
          "from_kinds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "subPropertyOf": {
            "type": "string",
            "description": "Core verb this extension specializes (e.g. surface-openers chain to navigates/returnsTo)."
          },
          "to_kinds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "edges": {
      "type": "array",
      "description": "The flat typed-edge array (document order is meaningful: findings and branch-set grouping follow it).",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "meta": {
      "type": "object",
      "description": "Author-owned metadata. Only the keys below are engine-read; everything else passes through.",
      "properties": {
        "flows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/flow"
          },
          "description": "First-class named journeys. Shape violations are E_FLOW_*; a declared terminal/via the trace traversal cannot reach from the entry is the advisory W_FLOW_UNREACHABLE. `validate --json` reports the declared count as 'flows' (omitted when zero)."
        },
        "lints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Opt-in advisory lint packs (e.g. 'slice-coverage', 'design-completeness')."
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "slice_of": {
          "$ref": "#/$defs/sliceOf"
        },
        "waivers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/waiver"
          },
          "description": "The warning baseline: advisory findings waived by (code, node). A waived advisory reports as severity 'waived' with a visible count — never silent, never exit-code-relevant."
        }
      },
      "additionalProperties": true
    },
    "nodeKindRegistry": {
      "type": "object",
      "description": "Declarative node-kind extensions: 'x-<ns>:Name' → row (data overlays, never code plugins).",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "attrs": {
            "type": "object",
            "description": "Declared attr enums (e.g. 'outcome' for boundary returnsTo arms)."
          },
          "layer": {
            "enum": [
              "boundary",
              "logic",
              "policy",
              "substrate",
              "surface"
            ]
          },
          "legal_in_edges": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "legal_out_edges": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "nodes": {
      "type": "object",
      "description": "Nodes filed by layer: nodes.<layer>.<slug> → node. A core kind filed under the wrong layer is E_LAYER_MISMATCH; node ids are unique across ALL layers (E_DUP_ID).",
      "properties": {
        "boundary": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/node"
          },
          "x-maapp-coreKinds": []
        },
        "logic": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/node"
          },
          "x-maapp-coreKinds": [
            "Assertion",
            "EffectAction",
            "MutationAction",
            "NavAction",
            "QueryAction",
            "Trigger",
            "ViewState",
            "ViewStateAction"
          ]
        },
        "policy": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/node"
          },
          "x-maapp-coreKinds": [
            "Policy"
          ]
        },
        "substrate": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/node"
          },
          "x-maapp-coreKinds": [
            "BackendOp",
            "DataSource",
            "PipelineStage",
            "SideEffect",
            "StateStore"
          ]
        },
        "surface": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/node"
          },
          "x-maapp-coreKinds": [
            "Component",
            "NavContainer",
            "Screen"
          ]
        }
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "$ref": "#/$defs/node"
        }
      }
    },
    "refsRegistry": {
      "type": "object",
      "description": "Declarative refs-key extensions (open-with-registry, A3): key → row. A registry-declared key's VALUE shape is app-owned.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "schema": {
      "type": "string",
      "pattern": "^.+-graph$",
      "description": "Schema id. Canonical: 'maapp-graph'. Any non-empty '<app>-graph' prefix is accepted as a compat rule."
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "MAJOR.MINOR string. This engine supports major 1, minors 0-4; an unknown minor of a known major validates with advisory W_VERSION_MINOR only (additive-minor policy)."
    }
  },
  "$defs": {
    "edge": {
      "type": "object",
      "description": "Typed edge {type, from, to, attrs…}. Endpoints must resolve to node ids (E_DANGLING); the from/to KIND sets per verb are the x-maapp-fromKinds/x-maapp-toKinds annotations below, enforced by validate (E_KIND). Empty kind-set = any kind.",
      "required": [
        "from",
        "to",
        "type"
      ],
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "type": {
          "anyOf": [
            {
              "enum": [
                "binds",
                "derivesFrom",
                "dismisses",
                "emits",
                "fires",
                "guardedBy",
                "handles",
                "invokes",
                "navigates",
                "produces",
                "reads",
                "renders",
                "setsViewState",
                "writes"
              ]
            },
            {
              "type": "string",
              "pattern": "^x-",
              "description": "edgeRegistry-declared extension verb."
            }
          ]
        },
        "when": {
          "type": "string",
          "description": "Branch guard: an Assertion id (navigates), an outcome token (x-ext:returnsTo), or the literal \"else\". Branch sets are all-conditional + mutually exclusive (E_BRANCH_*)."
        }
      },
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "binds"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "x-maapp-fromKinds": [
              "Component",
              "Screen",
              "ViewState"
            ],
            "x-maapp-toKinds": [
              "DataSource",
              "StateStore",
              "ViewState"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "derivesFrom"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "x-maapp-fromKinds": [
              "Assertion",
              "StateStore",
              "ViewState"
            ],
            "x-maapp-toKinds": [
              "DataSource",
              "PipelineStage",
              "StateStore",
              "ViewState"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "dismisses"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "target"
            ],
            "properties": {
              "target": {
                "anyOf": [
                  {
                    "enum": [
                      "count",
                      "root",
                      "self"
                    ]
                  },
                  {
                    "type": "string",
                    "description": "Extension value; legal ONLY if declared under 'dismisses.target' in the graph's attrEnumRegistry (undeclared non-core values are E_ATTR_ENUM; namespace NEW tokens x-<ns>:, bare tokens are accepted for domain-specific vocabularies)."
                  },
                  {
                    "const": "else",
                    "description": "Branch-set default arm."
                  }
                ]
              }
            },
            "x-maapp-fromKinds": [
              "MutationAction",
              "NavAction"
            ],
            "x-maapp-toKinds": [
              "NavContainer",
              "Screen"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "emits"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "effect": {
                "type": "string",
                "description": "Open side-effect hint (SCHEMA.md suggests analytics, haptic, log, notification, toast, clipboard, systemShare, openURL, externalApp, timer — any app-specific value incl. x-* is also legal). Deliberately NOT validator-checked."
              }
            },
            "x-maapp-fromKinds": [
              "BackendOp",
              "EffectAction",
              "MutationAction",
              "PipelineStage",
              "x-ext:ExternalSurface",
              "x-ext:PermissionGate"
            ],
            "x-maapp-toKinds": [
              "SideEffect"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "fires"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "x-maapp-fromKinds": [
              "Trigger",
              "x-ext:ExternalSurface",
              "x-ext:PermissionGate"
            ],
            "x-maapp-toKinds": [
              "EffectAction",
              "MutationAction",
              "NavAction",
              "QueryAction",
              "Trigger",
              "ViewStateAction"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "guardedBy"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "polarity"
            ],
            "properties": {
              "polarity": {
                "anyOf": [
                  {
                    "enum": [
                      "forbid",
                      "require"
                    ]
                  },
                  {
                    "type": "string",
                    "description": "Extension value; legal ONLY if declared under 'guardedBy.polarity' in the graph's attrEnumRegistry (undeclared non-core values are E_ATTR_ENUM; namespace NEW tokens x-<ns>:, bare tokens are accepted for domain-specific vocabularies)."
                  },
                  {
                    "const": "else",
                    "description": "Branch-set default arm."
                  }
                ]
              }
            },
            "x-maapp-fromKinds": [
              "BackendOp",
              "DataSource",
              "EffectAction",
              "MutationAction",
              "NavAction",
              "PipelineStage",
              "QueryAction",
              "Trigger",
              "ViewStateAction"
            ],
            "x-maapp-toKinds": [
              "Assertion",
              "Policy"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "handles"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "event"
            ],
            "properties": {
              "event": {
                "anyOf": [
                  {
                    "enum": [
                      "appear",
                      "change",
                      "doubleTap",
                      "dragDismiss",
                      "endReached",
                      "longPress",
                      "pullToRefresh",
                      "submit",
                      "swipe",
                      "tap",
                      "timer"
                    ]
                  },
                  {
                    "type": "string",
                    "description": "Extension value; legal ONLY if declared under 'handles.event' in the graph's attrEnumRegistry (undeclared non-core values are E_ATTR_ENUM; namespace NEW tokens x-<ns>:, bare tokens are accepted for domain-specific vocabularies)."
                  },
                  {
                    "const": "else",
                    "description": "Branch-set default arm."
                  }
                ]
              }
            },
            "x-maapp-fromKinds": [
              "Component",
              "Screen"
            ],
            "x-maapp-toKinds": [
              "Trigger"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "invokes"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "awaits"
            ],
            "x-maapp-fromKinds": [
              "BackendOp",
              "MutationAction",
              "PipelineStage"
            ],
            "x-maapp-toKinds": [
              "BackendOp",
              "PipelineStage"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "navigates"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "present"
            ],
            "properties": {
              "present": {
                "anyOf": [
                  {
                    "enum": [
                      "deep-link",
                      "fullScreen",
                      "fullScreenCover",
                      "popover",
                      "push",
                      "replace-root",
                      "sheet",
                      "tab-switch"
                    ]
                  },
                  {
                    "type": "string",
                    "description": "Extension value; legal ONLY if declared under 'navigates.present' in the graph's attrEnumRegistry (undeclared non-core values are E_ATTR_ENUM; namespace NEW tokens x-<ns>:, bare tokens are accepted for domain-specific vocabularies)."
                  },
                  {
                    "const": "else",
                    "description": "Branch-set default arm."
                  }
                ]
              }
            },
            "x-maapp-fromKinds": [
              "MutationAction",
              "NavAction",
              "NavContainer"
            ],
            "x-maapp-toKinds": [
              "NavContainer",
              "Screen",
              "x-ext:ExternalSurface"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "produces"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "artifact"
            ],
            "properties": {
              "verification": {
                "anyOf": [
                  {
                    "enum": [
                      "unverified",
                      "verified"
                    ]
                  },
                  {
                    "type": "string",
                    "description": "Extension value; legal ONLY if declared under 'produces.verification' in the graph's attrEnumRegistry (undeclared non-core values are E_ATTR_ENUM; namespace NEW tokens x-<ns>:, bare tokens are accepted for domain-specific vocabularies)."
                  },
                  {
                    "const": "else",
                    "description": "Branch-set default arm."
                  }
                ]
              }
            },
            "x-maapp-fromKinds": [
              "BackendOp",
              "PipelineStage"
            ],
            "x-maapp-toKinds": [
              "DataSource",
              "StateStore"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "reads"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "cachePolicy": {
                "anyOf": [
                  {
                    "enum": [
                      "cached",
                      "fresh",
                      "stale-while-revalidate"
                    ]
                  },
                  {
                    "type": "string",
                    "description": "Extension value; legal ONLY if declared under 'reads.cachePolicy' in the graph's attrEnumRegistry (undeclared non-core values are E_ATTR_ENUM; namespace NEW tokens x-<ns>:, bare tokens are accepted for domain-specific vocabularies)."
                  },
                  {
                    "const": "else",
                    "description": "Branch-set default arm."
                  }
                ]
              }
            },
            "x-maapp-fromKinds": [
              "BackendOp",
              "PipelineStage",
              "QueryAction"
            ],
            "x-maapp-toKinds": [
              "DataSource",
              "StateStore"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "renders"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "x-maapp-fromKinds": [
              "NavContainer",
              "Screen"
            ],
            "x-maapp-toKinds": [
              "Component",
              "NavContainer"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "setsViewState"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "x-maapp-fromKinds": [
              "ViewStateAction"
            ],
            "x-maapp-toKinds": [
              "ViewState"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "writes"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "mode"
            ],
            "properties": {
              "mode": {
                "anyOf": [
                  {
                    "enum": [
                      "append",
                      "delete",
                      "set",
                      "toggle"
                    ]
                  },
                  {
                    "type": "string",
                    "description": "Extension value; legal ONLY if declared under 'writes.mode' in the graph's attrEnumRegistry (undeclared non-core values are E_ATTR_ENUM; namespace NEW tokens x-<ns>:, bare tokens are accepted for domain-specific vocabularies)."
                  },
                  {
                    "const": "else",
                    "description": "Branch-set default arm."
                  }
                ]
              }
            },
            "x-maapp-fromKinds": [
              "BackendOp",
              "MutationAction",
              "PipelineStage"
            ],
            "x-maapp-toKinds": [
              "DataSource",
              "StateStore"
            ]
          }
        }
      ]
    },
    "flow": {
      "type": "object",
      "description": "One named end-to-end journey. `entry` must resolve to a Screen or a ROOT Trigger (no handles in-edge; E_FLOW_ENTRY); every slug must resolve (E_FLOW_UNRESOLVED); names are unique (E_FLOW_DUP_NAME); other shape violations are E_FLOW_MALFORMED. Reachability from entry over the q_trace edge family is derived at validate time (advisory W_FLOW_UNREACHABLE).",
      "required": [
        "entry",
        "name",
        "terminals"
      ],
      "properties": {
        "entry": {
          "type": "string",
          "description": "The Screen (user lands) or root-Trigger (system event, attrs.cause) slug where the journey starts."
        },
        "name": {
          "type": "string",
          "description": "Unique flow name (the stable id a consumer/eval scores against)."
        },
        "terminals": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "Substrate/end slugs the journey must reach."
        },
        "via": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Optional intermediate waypoint slugs (also reachability-checked)."
        }
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "attrs": {
          "type": "object",
          "description": "Author-owned attributes (e.g. a declarative 'surface' taxonomy)."
        },
        "intent": {
          "type": "string",
          "description": "One-line human intent."
        },
        "kind": {
          "anyOf": [
            {
              "enum": [
                "Assertion",
                "BackendOp",
                "Component",
                "DataSource",
                "EffectAction",
                "MutationAction",
                "NavAction",
                "NavContainer",
                "PipelineStage",
                "Policy",
                "QueryAction",
                "Screen",
                "SideEffect",
                "StateStore",
                "Trigger",
                "ViewState",
                "ViewStateAction"
              ]
            },
            {
              "type": "string",
              "pattern": "^x-",
              "description": "nodeKindRegistry-declared extension kind."
            }
          ]
        },
        "refs": {
          "$ref": "#/$defs/refs"
        }
      },
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "Trigger"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "attrs": {
                "properties": {
                  "cause": {
                    "anyOf": [
                      {
                        "enum": [
                          "callback",
                          "cron",
                          "deep-link",
                          "message",
                          "schedule",
                          "system",
                          "webhook"
                        ]
                      },
                      {
                        "type": "string",
                        "description": "Extension cause; legal ONLY if declared under 'Trigger.cause' in the graph's attrEnumRegistry (undeclared values are E_TRIGGER_CAUSE; x-<ns>:token recommended)."
                      }
                    ],
                    "description": "What summons this Trigger. A Trigger with NO handles in-edge is a legal ROOT when it carries a cause: it models a system-initiated entry point (webhook/cron/callback/...) and is a legal flow entry + trace root."
                  }
                }
              }
            }
          }
        }
      ]
    },
    "provenance": {
      "type": "object",
      "description": "Trust stamp: who/what produced this graph. Every value is AUTHORED data — the engine never computes commits or timestamps (determinism rule). Unknown keys are E_PROVENANCE_KEY.",
      "required": [
        "origin"
      ],
      "properties": {
        "asOf": {
          "type": "string",
          "description": "Source-repo SHA at last sync (LIFECYCLE-VERBS-SPEC §6.2): check-drift's base rev, bumped by `maapp stamp` / lifecycle updates. Distinct from sourceCommit (the ingest-time origin commit)."
        },
        "fidelity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Authored 0..=1 estimate of ingest completeness."
        },
        "generatedAt": {
          "type": "string",
          "description": "Authored timestamp string (never engine-computed)."
        },
        "origin": {
          "enum": [
            "generated",
            "ingested",
            "ratified"
          ],
          "description": "generated = LLM-authored from a brief; ingested = derived from a real codebase (enables the advisory W_ANCHORLESS anchor lint); ratified = human-reviewed and signed off."
        },
        "sourceCommit": {
          "type": "string",
          "description": "Commit of the source codebase an ingested graph was derived from."
        }
      },
      "additionalProperties": false
    },
    "refs": {
      "type": "object",
      "description": "Closed-key refs block: the core keys below, plus any key declared in the graph's refsRegistry (undeclared non-core keys are E_REFS_KEY). Use {} when empty.",
      "properties": {
        "data": {
          "type": "string"
        },
        "decision": {
          "type": "string",
          "description": "Graph-internal decision id, e.g. 'ADR-008' / 'D-003' / 'PLAN-2' (advisory W_REFS_FORM)."
        },
        "design": {
          "type": "string",
          "pattern": "^(file:|figma:|render:)",
          "description": "Design anchor: file:<path> | figma:<key/node> | render:<id> (E_REFS_FORM)."
        },
        "slice": {
          "type": "string",
          "pattern": "^S[0-9A-Za-z]+$",
          "description": "Walking-skeleton slice id, e.g. 'S0' (E_REFS_FORM)."
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/sourceAnchor"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/sourceAnchor"
              }
            }
          ],
          "description": "Core source anchor(s) tying the node to code: one anchor or an array. Required in spirit for ingested graphs (advisory W_ANCHORLESS on Screen/StateStore/BackendOp/Assertion when meta.provenance.origin='ingested')."
        },
        "spec": {
          "type": "string"
        },
        "tokens": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "sliceOf": {
      "type": "object",
      "description": "Slice annotation stamped by `maapp export --slice` (LIFECYCLE-VERBS-SPEC §5). Presence puts validate in slice mode: W_ORPHAN is suppressed (slicing creates boundary orphans by construction). Shape violations are E_SLICE_OF_MALFORMED.",
      "required": [
        "selector"
      ],
      "properties": {
        "depth": {
          "type": "integer",
          "minimum": 0,
          "description": "Neighborhood depth (slug-selector form only; scope slices carry no depth)."
        },
        "selector": {
          "type": "string",
          "description": "The slice selector: a node slug (BFS neighborhood) or 'scope:<scope>' (all *:<scope>/* nodes)."
        }
      },
      "additionalProperties": false
    },
    "sourceAnchor": {
      "type": "string",
      "pattern": "^[^#@]+(#L[0-9]+(-L[0-9]+)?|@.+)?$",
      "not": {
        "anyOf": [
          {
            "pattern": "^/"
          },
          {
            "pattern": "(^|/)\\.\\.(/|#|@|$)"
          }
        ]
      },
      "description": "Repo-relative source anchor: 'relative/path.ext' + optional '#L<start>', '#L<start>-L<end>' or '@<symbol>'. Absolute paths and '..' segments are E_REFS_FORM. Existence on disk is NOT checked by validate (repo-independent + deterministic); drift detection is the future check-drift verb's job."
    },
    "waiver": {
      "type": "object",
      "description": "One advisory waiver: the named W_* finding on the named node reports as 'waived' (visible in the report's waived count) instead of a warning. E_* codes are NEVER waivable (E_WAIVER_FORBIDDEN); shape violations are E_WAIVER_MALFORMED.",
      "required": [
        "code",
        "node",
        "reason"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^W_",
          "description": "The W_* advisory code being waived."
        },
        "node": {
          "type": "string",
          "description": "The node slug the finding names (must appear in the finding's ids)."
        },
        "reason": {
          "type": "string",
          "description": "Why this advisory is accepted — the audit trail, never optional."
        }
      },
      "additionalProperties": false
    }
  }
}
