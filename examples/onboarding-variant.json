      "type": "writes",
      "from": "act:pref/SaveReminderAndAdvance",
      "to": "store:pref/PrefStore",
      "mode": "set"
    },
    {
      "type": "x-ext:returnsTo",
      "from": "x-ext:auth/OAuthRedirect",
      "to": "screen:auth/Choice",
      "present": "push",
      "when": "cancelled"
    },
    {
      "type": "x-ext:returnsTo",
      "from": "x-ext:auth/OAuthRedirect",
      "to": "screen:auth/Choice",
      "present": "push",
      "when": "failed"
    },
    {
      "type": "x-ext:returnsTo",
      "from": "x-ext:auth/OAuthRedirect",
      "to": "screen:perm/NotificationPriming",
      "present": "replace-root",
      "when": "success",
      "writesBack": "SessionStore.token"
    },
    {
      "type": "x-ext:returnsTo",
      "from": "x-ext:perm/NotificationsPrompt",
      "to": "screen:pref/Goal",
      "present": "push",
      "when": "granted",
      "writesBack": "PrefStore.notificationsEnabled"
    },
    {
      "type": "x-ext:returnsTo",
      "from": "x-ext:perm/NotificationsPrompt",
      "to": "screen:pref/Goal",
      "present": "push",
      "when": "denied"
    },
    {
      "type": "x-ext:returnsTo",
      "from": "x-ext:perm/NotificationsPrompt",
      "to": "screen:pref/Goal",
      "present": "push",
      "when": "limited"
    }
  ]
}
