{
  "meta": {
    "schema": "checkout-graph",
    "version": "1.3",
    "vocab": "spec/EDGE-VOCABULARY.md",
    "app": "e-commerce checkout (cart -> shipping -> payment -> confirm -> complete)",
    "mobbin_ref": "Under Armour 'Purchasing a product' flow eab13d90-ca43-4141-80ee-849aabe60726; richer payment-method boundary modeled after SHEIN 'Placing an order' 0509f742",
    "query": "graph query <node|neighbors|blast-radius|trace|view|orphans> [args] <file>",
    "validate": "graph validate <file>"
  },
  "schema": "checkout-graph",
  "version": "1.3",
  "nodeKindRegistry": {
    "x-ext:ExternalSurface": {
      "kind": "x-ext:ExternalSurface",
      "layer": "boundary",
      "legal_in_edges": [
        "navigates"
      ],
      "legal_out_edges": [
        "returnsTo",
        "fires",
        "emits"
      ],
      "attrs": {
        "surfaceKind": [
          "osShareSheet",
          "applePaySheet",
          "oauthRedirect",
          "threeDSChallenge",
          "externalApp"
        ],
        "outcome": [
          "success",
          "cancelled",
          "failed"
        ]
      }
    },
    "x-ext:PermissionGate": {
      "kind": "x-ext:PermissionGate",
      "layer": "boundary",
      "legal_in_edges": [
        "navigates",
        "fires"
      ],
      "legal_out_edges": [
        "returnsTo",
        "fires",
        "emits"
      ],
      "attrs": {
        "outcome": [
          "granted",
          "denied",
          "limited"
        ],
        "persistent": true,
        "rePromptable": true
      }
    }
  },
  "edgeRegistry": {
    "x-behavior:reconciles": {
      "ns": "x-behavior",
      "from_kinds": [
        "BackendOp"
      ],
      "to_kinds": [
        "StateStore"
      ],
      "family": "COMMAND",
      "subPropertyOf": "writes",
      "attrs": {
        "onFailure": [
          "rollback",
          "retain",
          "escalate"
        ]
      }
    },
    "x-ext:returnsTo": {
      "ns": "x-ext",
      "from_kinds": [
        "x-ext:ExternalSurface",
        "x-ext:PermissionGate"
      ],
      "to_kinds": [
        "Screen",
        "NavContainer"
      ],
      "family": "NAV",
      "subPropertyOf": "navigates",
      "attrs": {
        "when": "<outcome-value|\"else\">",
        "writesBack": "<StateStore.key>"
      }
    }
  },
  "nodeKinds": {
    "surface": [
      "Screen",
      "Component",
      "NavContainer"
    ],
    "logic": [
      "Trigger",
      "NavAction",
      "MutationAction",
      "EffectAction",
      "ViewStateAction",
      "QueryAction",
      "ViewState",
      "Assertion"
    ],
    "substrate": [
      "StateStore",
      "DataSource",
      "BackendOp",
      "PipelineStage",
      "SideEffect"
    ],
    "policy": [
      "Policy"
    ],
    "boundary": []
  },
  "nodes": {
    "surface": {
      "screen:cart/Bag": {
        "kind": "Screen",
        "intent": "Cart/bag: line items, promos, order summary, Checkout CTA.",
        "refs": {}
      },
      "screen:checkout/Shipping": {
        "kind": "Screen",
        "intent": "Shipping/address step: shows saved address + delivery method; Continue to payment.",
        "refs": {}
      },
      "screen:checkout/AddressForm": {
        "kind": "Screen",
        "intent": "Address-entry sheet: name/street/city/zip fields with inline validation; Save and continue.",
        "refs": {}
      },
      "screen:checkout/Payment": {
        "kind": "Screen",
        "intent": "Payment-method step: radio set (Card / Apple Pay / PayPal); Continue.",
        "refs": {}
      },
      "screen:checkout/CardEntry": {
        "kind": "Screen",
        "intent": "Card-entry sheet: card number / expiry / CVV + remember-card toggle; Save card.",
        "refs": {}
      },
      "screen:checkout/Review": {
        "kind": "Screen",
        "intent": "Final review/confirm: address + payment + totals; Place Order CTA (duplicate-submit hazard).",
        "refs": {}
      },
      "screen:checkout/Complete": {
        "kind": "Screen",
        "intent": "Order complete: 'You're all set', order number, confirmation-email notice.",
        "refs": {}
      },
      "comp:cart/LineItemList": {
        "kind": "Component",
        "intent": "Renders the cart line items (image, title, qty stepper, price).",
        "refs": {}
      },
      "comp:cart/OrderSummary": {
        "kind": "Component",
        "intent": "Renders subtotal / shipping / taxes / estimated total from the cart store.",
        "refs": {}
      },
      "comp:checkout/AddressCard": {
        "kind": "Component",
        "intent": "Renders the currently-selected shipping address summary.",
        "refs": {}
      },
      "comp:checkout/PlaceOrderButton": {
        "kind": "Component",
        "intent": "Primary Place-Order button; disabled while a submit is in flight to prevent double-charge.",
        "refs": {}
      },
      "screen:checkout/DeliveryMethod": {
        "kind": "Screen",
        "intent": "Delivery-method picker: choose shipping speed (Standard / Express / Overnight) with prices and ETAs; Confirm.",
        "refs": {}
      },
      "screen:cart/PromoCode": {
        "kind": "Screen",
        "intent": "Promo-code sheet: enter and apply a coupon; reflects the discount in the order summary.",
        "refs": {}
      },
      "screen:checkout/OrderFailed": {
        "kind": "Screen",
        "intent": "Order-failed: payment declined / place-order error; shows the reason and a Retry / change-payment CTA.",
        "refs": {}
      }
    },
    "logic": {
      "trig:cart/CheckoutTap": {
        "kind": "Trigger",
        "intent": "User taps Checkout on the bag.",
        "refs": {}
      },
      "trig:cart/QtyChange": {
        "kind": "Trigger",
        "intent": "User changes a line-item quantity via the stepper.",
        "refs": {}
      },
      "trig:shipping/EditAddressTap": {
        "kind": "Trigger",
        "intent": "User taps to edit/add the shipping address.",
        "refs": {}
      },
      "trig:shipping/ContinueTap": {
        "kind": "Trigger",
        "intent": "User taps Continue on the shipping step.",
        "refs": {}
      },
      "trig:address/FieldChange": {
        "kind": "Trigger",
        "intent": "User edits an address form field (name/street/city/zip).",
        "refs": {}
      },
      "trig:address/SaveTap": {
        "kind": "Trigger",
        "intent": "User taps Save & Continue on the address form.",
        "refs": {}
      },
      "trig:address/CancelTap": {
        "kind": "Trigger",
        "intent": "User dismisses the address form without saving.",
        "refs": {}
      },
      "trig:pay/MethodSelect": {
        "kind": "Trigger",
        "intent": "User selects a payment method radio (Card / Apple Pay / PayPal).",
        "refs": {}
      },
      "trig:pay/ContinueTap": {
        "kind": "Trigger",
        "intent": "User taps Continue on the payment step.",
        "refs": {}
      },
      "trig:card/SaveTap": {
        "kind": "Trigger",
        "intent": "User taps Save on the card-entry sheet.",
        "refs": {}
      },
      "trig:review/PlaceOrderTap": {
        "kind": "Trigger",
        "intent": "User taps Place Order on the review screen.",
        "refs": {}
      },
      "act:cart/GoToShipping": {
        "kind": "NavAction",
        "intent": "Advance from the bag to the shipping step.",
        "refs": {}
      },
      "act:cart/LogCheckoutStart": {
        "kind": "EffectAction",
        "intent": "Emit the checkout-started analytics event (independent fan-out alongside the nav).",
        "refs": {}
      },
      "act:cart/UpdateQty": {
        "kind": "MutationAction",
        "intent": "Write the new quantity into the cart store; totals re-derive.",
        "refs": {}
      },
      "act:shipping/PresentAddressForm": {
        "kind": "NavAction",
        "intent": "Present the address-entry sheet.",
        "refs": {}
      },
      "act:shipping/Continue": {
        "kind": "NavAction",
        "intent": "Advance from shipping to payment (guarded by address-present).",
        "refs": {}
      },
      "act:address/UpdateField": {
        "kind": "ViewStateAction",
        "intent": "Write the edited field value into the local address-form view state.",
        "refs": {}
      },
      "act:address/SaveAndContinue": {
        "kind": "MutationAction",
        "intent": "G15: persist the address to the store AND dismiss back to shipping in one tap (save-and-close), guarded by form-valid.",
        "refs": {}
      },
      "act:address/Cancel": {
        "kind": "NavAction",
        "intent": "Dismiss the address form without saving.",
        "refs": {}
      },
      "act:pay/SelectMethod": {
        "kind": "MutationAction",
        "intent": "Write the chosen payment method into the checkout store.",
        "refs": {}
      },
      "act:pay/Continue": {
        "kind": "NavAction",
        "intent": "Branch on chosen method: card -> review, Apple Pay -> Apple Pay sheet.",
        "refs": {}
      },
      "act:pay/PresentCardEntry": {
        "kind": "NavAction",
        "intent": "Present the card-entry sheet when Card is selected.",
        "refs": {}
      },
      "act:card/SaveCard": {
        "kind": "MutationAction",
        "intent": "G15: tokenize+write the card to the checkout store AND dismiss back to payment in one tap.",
        "refs": {}
      },
      "act:review/PlaceOrder": {
        "kind": "MutationAction",
        "intent": "Submit the order: invoke the irreversible non-idempotent place-order backend op + emit analytics + advance to complete (G15 save-and-advance).",
        "refs": {}
      },
      "vs:address/Form": {
        "kind": "ViewState",
        "intent": "Local address-form field state (name/street/city/zip) before persistence.",
        "refs": {},
        "attrs": {
          "phase": "editing"
        }
      },
      "vs:checkout/Submitting": {
        "kind": "ViewState",
        "intent": "In-flight submit flag; disables Place Order to block duplicate submits.",
        "refs": {},
        "attrs": {
          "phase": "live"
        }
      },
      "assert:address/Valid": {
        "kind": "Assertion",
        "intent": "G16: address form is valid (all required fields well-formed). Derives from the live form view state, not a persisted store.",
        "refs": {}
      },
      "assert:shipping/AddressPresent": {
        "kind": "Assertion",
        "intent": "A shipping address must be saved before advancing to payment.",
        "refs": {}
      },
      "assert:pay/CardSelected": {
        "kind": "Assertion",
        "intent": "The chosen payment method is a saved card (the in-app review path).",
        "refs": {}
      },
      "assert:pay/WalletSelected": {
        "kind": "Assertion",
        "intent": "The chosen payment method is an external wallet (Apple Pay) requiring a handoff.",
        "refs": {}
      },
      "assert:review/NotSubmitting": {
        "kind": "Assertion",
        "intent": "No submit is currently in flight (duplicate-submit guard for Place Order).",
        "refs": {}
      },
      "trig:shipping/EditDeliveryTap": {
        "kind": "Trigger",
        "intent": "User taps to change the delivery method on the shipping step.",
        "refs": {}
      },
      "act:shipping/PresentDeliveryMethod": {
        "kind": "NavAction",
        "intent": "Present the delivery-method picker sheet.",
        "refs": {}
      },
      "trig:delivery/ConfirmTap": {
        "kind": "Trigger",
        "intent": "User taps Confirm on the delivery-method picker.",
        "refs": {}
      },
      "act:delivery/Confirm": {
        "kind": "NavAction",
        "intent": "Dismiss the delivery-method picker back to shipping.",
        "refs": {}
      },
      "trig:cart/PromoTap": {
        "kind": "Trigger",
        "intent": "User taps to add/apply a promo code on the bag.",
        "refs": {}
      },
      "act:cart/PresentPromoCode": {
        "kind": "NavAction",
        "intent": "Present the promo-code sheet.",
        "refs": {}
      },
      "trig:promo/ApplyTap": {
        "kind": "Trigger",
        "intent": "User taps Apply on the promo-code sheet.",
        "refs": {}
      },
      "act:promo/Apply": {
        "kind": "NavAction",
        "intent": "Dismiss the promo-code sheet back to the bag.",
        "refs": {}
      },
      "trig:order/RetryTap": {
        "kind": "Trigger",
        "intent": "User taps Retry on the order-failed screen.",
        "refs": {}
      },
      "act:order/Retry": {
        "kind": "NavAction",
        "intent": "Return to the review step to retry placing the order.",
        "refs": {}
      }
    },
    "substrate": {
      "store:CartStore": {
        "kind": "StateStore",
        "intent": "Cart line items + quantities + computed totals.",
        "refs": {}
      },
      "store:CheckoutStore": {
        "kind": "StateStore",
        "intent": "Checkout draft: selected address, payment method, tokenized card, submit flag.",
        "refs": {}
      },
      "store:OrderStore": {
        "kind": "StateStore",
        "intent": "Placed orders (order number, confirmation, receipt).",
        "refs": {}
      },
      "op:checkout/PlaceOrder": {
        "kind": "BackendOp",
        "intent": "Server place-order call: charges payment, creates the order. Irreversible, non-idempotent without a key.",
        "refs": {}
      },
      "fx:analytics/CheckoutStarted": {
        "kind": "SideEffect",
        "intent": "Analytics event when checkout begins.",
        "refs": {}
      },
      "fx:analytics/OrderPlaced": {
        "kind": "SideEffect",
        "intent": "Analytics event when an order is successfully placed.",
        "refs": {}
      },
      "fx:analytics/ApplePayResult": {
        "kind": "SideEffect",
        "intent": "Analytics event for the Apple Pay sheet outcome (success/cancelled/failed).",
        "refs": {}
      },
      "fx:haptic/OrderSuccess": {
        "kind": "SideEffect",
        "intent": "Success haptic when the order completes.",
        "refs": {}
      }
    },
    "policy": {
      "policy:pci/CardData": {
        "kind": "Policy",
        "intent": "PCI-DSS gate on raw card handling: card data is tokenized client-side; the backend op never sees PAN. DEFERRED-status posture gate, not a runtime predicate.",
        "attrs": {
          "status": "deferred",
          "gate": "binary"
        },
        "refs": {}
      }
    },
    "boundary": {
      "x-ext:pay/ApplePaySheet": {
        "kind": "x-ext:ExternalSurface",
        "intent": "Apple Pay payment sheet: control leaves the app; returns keyed on the sheet outcome.",
        "refs": {},
        "attrs": {
          "surfaceKind": "applePaySheet",
          "outcome": "success"
        }
      }
    }
  },
