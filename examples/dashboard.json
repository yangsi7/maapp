  "nodes": {
    "surface": {
      "screen:analytics/Overview": {
        "kind": "Screen",
        "intent": "Analytics overview: scroll of metric cards (net cashflow, income, spending, merchant revenue), each with a sparkline/bar chart for the active period.",
        "refs": {}
      },
      "screen:analytics/FilterPeriod": {
        "kind": "Screen",
        "intent": "Filter-by-period sheet: weekly/monthly/yearly segment + month/year picker + 'Apply to all charts' toggle.",
        "refs": {}
      },
      "screen:analytics/MetricDetail": {
        "kind": "Screen",
        "intent": "Drill-down detail for one metric: full-height chart, breakdown rows, export button.",
        "refs": {}
      },
      "comp:analytics/MetricCard": {
        "kind": "Component",
        "intent": "One metric card: title, headline value, delta %, inline chart for the active filter range.",
        "refs": {}
      },
      "comp:analytics/ChartView": {
        "kind": "Component",
        "intent": "Reusable chart renderer (line/bar) bound to a chart-series store; shows loading/empty/error states.",
        "refs": {}
      },
      "comp:analytics/PeriodSegment": {
        "kind": "Component",
        "intent": "Weekly/Monthly/Yearly segmented control inside the filter sheet, bound to the draft filter view-state.",
        "refs": {}
      },
      "comp:analytics/BreakdownList": {
        "kind": "Component",
        "intent": "Per-category breakdown rows on the metric-detail screen.",
        "refs": {}
      }
    },
    "logic": {
      "trig:overview/Appear": {
        "kind": "Trigger",
        "intent": "Overview screen appears (initial load + return).",
        "refs": {}
      },
      "trig:overview/PullToRefresh": {
        "kind": "Trigger",
        "intent": "User pulls to refresh the overview.",
        "refs": {}
      },
      "trig:overview/FilterTap": {
        "kind": "Trigger",
        "intent": "User taps the filter/period chip in the header.",
        "refs": {}
      },
      "trig:overview/CardTap": {
        "kind": "Trigger",
        "intent": "User taps a metric card to drill in.",
        "refs": {}
      },
      "trig:filter/SegmentChange": {
        "kind": "Trigger",
        "intent": "User changes weekly/monthly/yearly or the picker value in the filter sheet.",
        "refs": {}
      },
      "trig:filter/ApplyTap": {
        "kind": "Trigger",
        "intent": "User taps 'Done/Apply' in the filter sheet.",
        "refs": {}
      },
      "trig:filter/CancelTap": {
        "kind": "Trigger",
        "intent": "User taps the X to dismiss the filter sheet without applying.",
        "refs": {}
      },
      "trig:detail/Appear": {
        "kind": "Trigger",
        "intent": "Metric-detail screen appears.",
        "refs": {}
      },
      "trig:detail/ExportTap": {
        "kind": "Trigger",
        "intent": "User taps the export/download button on the detail screen.",
        "refs": {}
      },
      "act:overview/LoadCharts": {
        "kind": "QueryAction",
        "intent": "Read the aggregated chart-series for the active filter range (cached-first on appear).",
        "refs": {}
      },
      "act:overview/RefreshCharts": {
        "kind": "QueryAction",
        "intent": "Force-fresh re-read of chart-series on pull-to-refresh.",
        "refs": {}
      },
      "act:overview/PresentFilter": {
        "kind": "NavAction",
        "intent": "Present the filter-by-period sheet.",
        "refs": {}
      },
      "act:overview/GoToDetail": {
        "kind": "NavAction",
        "intent": "Push the metric-detail drill-down for the tapped card.",
        "refs": {}
      },
      "act:filter/UpdateDraft": {
        "kind": "ViewStateAction",
        "intent": "Write the chosen period/granularity into the draft filter view-state as the user picks.",
        "refs": {}
      },
      "act:filter/ApplyAndClose": {
        "kind": "MutationAction",
        "intent": "G15 save-and-close: commit the draft filter to the FilterStore, kick the re-aggregation pipeline, emit analytics, and dismiss the sheet.",
        "refs": {}
      },
      "act:filter/Cancel": {
        "kind": "NavAction",
        "intent": "Dismiss the filter sheet, discarding the draft.",
        "refs": {}
      },
      "act:detail/LoadDetail": {
        "kind": "QueryAction",
        "intent": "Read the detailed breakdown series for the selected metric + active range.",
        "refs": {}
      },
      "act:detail/Export": {
        "kind": "MutationAction",
        "intent": "Invoke the export backend op to render a CSV/PDF, then hand the file to the OS share sheet.",
        "refs": {}
      },
      "vs:filter/Draft": {
        "kind": "ViewState",
        "intent": "Ephemeral draft filter selection in the sheet (period kind + range), not yet applied.",
        "refs": {},
        "attrs": {
          "phase": "live"
        }
      },
      "vs:overview/ChartLoad": {
        "kind": "ViewState",
        "intent": "Loading/empty/error state for the metric charts before the chart-series store is populated.",
        "refs": {},
        "attrs": {
          "phase": "loading"
        }
      },
      "vs:detail/Load": {
        "kind": "ViewState",
        "intent": "Loading/empty/error state for the drill-down detail series.",
        "refs": {},
        "attrs": {
          "phase": "loading"
        }
      },
      "assert:filter/RangeValid": {
        "kind": "Assertion",
        "intent": "The draft filter range is well-formed (start <= end, supported granularity) before Apply can commit.",
        "refs": {}
      },
      "assert:overview/FilterApplied": {
        "kind": "Assertion",
        "intent": "An applied filter (period kind + active range) exists in FilterStore before the chart-series query can be scoped and run on appear.",
        "refs": {}
      },
      "assert:overview/RefreshNotInFlight": {
        "kind": "Assertion",
        "intent": "No chart refresh is already in flight (the chart-load phase is not 'loading') before a new force-fresh pull-to-refresh re-read is kicked off.",
        "refs": {}
      },
      "assert:overview/CardSeriesReady": {
        "kind": "Assertion",
        "intent": "The tapped metric card's chart series is present (its load completed non-error) before drilling into the metric-detail screen.",
        "refs": {}
      },
      "assert:filter/RawDataAvailable": {
        "kind": "Assertion",
        "intent": "The locally cached raw transactions are present (an initial ledger sync has completed) before committing a filter kicks the re-aggregation pipeline.",
        "refs": {}
      },
      "assert:detail/SeriesLoaded": {
        "kind": "Assertion",
        "intent": "The drill-down detail series has finished loading with a non-error, non-empty result before an export can be requested.",
        "refs": {}
      }
    },
    "substrate": {
      "store:FilterStore": {
        "kind": "StateStore",
        "intent": "Applied analytics filter (period kind + range), source of truth that drives every chart re-query.",
        "refs": {}
      },
      "store:RawTxnStore": {
        "kind": "StateStore",
        "intent": "Locally cached raw transactions/ledger rows synced from the backend; the pipeline's raw input.",
        "refs": {}
      },
      "store:AggregateStore": {
        "kind": "StateStore",
        "intent": "Per-bucket aggregates (sum/avg/delta per period bucket) for the active filter range.",
        "refs": {}
      },
      "store:ChartSeriesStore": {
        "kind": "StateStore",
        "intent": "Render-ready chart series (points/bars per metric) bound by the chart components.",
        "refs": {}
      },
      "store:DetailSeriesStore": {
        "kind": "StateStore",
        "intent": "Detailed per-category breakdown series for the drilled-in metric.",
        "refs": {}
      },
      "src:LedgerAPI": {
        "kind": "DataSource",
        "intent": "Remote ledger/transactions API; origin of raw transaction sync.",
        "refs": {}
      },
      "op:SyncLedger": {
        "kind": "BackendOp",
        "intent": "Backend sync that pulls fresh transactions into RawTxnStore.",
        "refs": {}
      },
      "op:ExportReport": {
        "kind": "BackendOp",
        "intent": "Render the export file (CSV/PDF) for the active metric + filter range.",
        "refs": {}
      },
      "stage:agg/Normalize": {
        "kind": "PipelineStage",
        "intent": "Normalize/bucket raw transactions into the filter's granularity (deterministic).",
        "attrs": {
          "llm": false,
          "stage": "NORMALIZE"
        },
        "refs": {}
      },
      "stage:agg/Aggregate": {
        "kind": "PipelineStage",
        "intent": "Fold normalized buckets into per-period aggregates (sum/avg/delta) — fan-in over the filter range.",
        "attrs": {
          "llm": false,
          "stage": "AGGREGATE"
        },
        "refs": {}
      },
      "stage:agg/Series": {
        "kind": "PipelineStage",
        "intent": "Project aggregates into render-ready chart series per metric (deterministic).",
        "attrs": {
          "llm": false,
          "stage": "SERIES"
        },
        "refs": {}
      },
      "fx:analytics/FilterApplied": {
        "kind": "SideEffect",
        "intent": "Analytics event when a filter is applied (period kind, range).",
        "refs": {}
      },
      "fx:analytics/ExportShared": {
        "kind": "SideEffect",
        "intent": "Analytics event when an export is successfully shared.",
        "refs": {}
      },
      "fx:toast/ExportFailed": {
        "kind": "SideEffect",
        "intent": "Toast shown when the export share fails.",
        "refs": {}
      }
    },
    "policy": {},
    "boundary": {
      "x-ext:share/ExportSheet": {
        "kind": "x-ext:ExternalSurface",
        "intent": "OS share sheet handed the rendered export file; control leaves the app and returns with an outcome.",
        "refs": {},
        "attrs": {
          "outcome": "success"
        }
      }
    }
  },
