  "edges": [
    {
      "type": "binds",
      "from": "comp:chat/ComposeBar",
      "to": "vs:thread/Compose"
    },
    {
      "type": "binds",
      "from": "comp:chat/ConversationRow",
      "to": "store:ConversationStore",
      "scopedBy": "row.conversationId"
    },
    {
      "type": "binds",
      "from": "comp:chat/MessageBubble",
      "to": "store:ThreadStore",
      "scopedBy": "message.clientId"
    },
    {
      "type": "binds",
      "from": "comp:chat/MessageList",
