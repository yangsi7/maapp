      "scopedBy": "ThreadStore.conversationId"
    },
    {
      "type": "binds",
      "from": "comp:chat/MessageList",
      "to": "vs:thread/HistoryLoad"
    },
    {
      "type": "binds",
      "from": "comp:chat/TypingIndicator",
