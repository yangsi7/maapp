      "from": "assert:thread/SubscriptionActive",
      "to": "ds:realtime/Socket"
    },
    {
      "type": "dismisses",
      "from": "act:info/GoBack",
      "to": "screen:chat/ConversationInfo",
      "target": "self"
    },
    {
      "type": "dismisses",
      "from": "act:newconv/GoBack",
      "to": "screen:chat/NewConversation",
      "target": "self"
    },
    {
      "type": "dismisses",
      "from": "act:newgroup/GoBack",
      "to": "screen:chat/NewGroup",
      "target": "self"
    },
    {
      "type": "dismisses",
      "from": "act:profile/GoBack",
      "to": "screen:chat/Profile",
      "target": "self"
    },
    {
      "type": "dismisses",
      "from": "act:search/GoBack",
      "to": "screen:chat/Search",
      "target": "self"
    },
    {
      "type": "dismisses",
      "from": "act:settings/GoBack",
      "to": "screen:chat/Settings",
      "target": "self"
    },
    {
      "type": "dismisses",
      "from": "act:shared/GoBack",
      "to": "screen:chat/SharedMedia",
      "target": "self"
    },
    {
      "type": "dismisses",
      "from": "act:thread/GoBack",
      "to": "screen:chat/Thread",
      "target": "self"
    },
    {
      "type": "dismisses",
      "from": "act:viewer/GoBack",
      "to": "screen:chat/MediaViewer",
      "target": "self"
    },
    {
      "type": "emits",
      "from": "act:thread/SendMessage",
      "to": "fx:analytics/MessageSent",
      "effect": "analytics"
    },
    {
      "type": "emits",
      "from": "act:thread/SendMessage",
      "to": "fx:haptic/Send",
      "effect": "haptic"
    },
    {
      "type": "emits",
      "from": "x-ext:pick/AttachmentSheet",
      "to": "fx:analytics/AttachmentPicked",
      "effect": "analytics"
    },
    {
      "type": "fires",
      "from": "trig:info/Back",
      "to": "act:info/GoBack",
