{
  "meta": {
    "schema": "chat-graph",
    "version": "1.4",
    "vocab": "docs/EDGE-VOCABULARY.md",
    "query": "graph query <node|neighbors|blast-radius|trace|view|orphans> [args] <file>",
    "validate": "graph validate <file>",
    "lints": []
  },
  "schema": "chat-graph",
  "version": "1.4",
  "nodeKindRegistry": {
    "x-ext:ExternalSurface": {
      "kind": "x-ext:ExternalSurface",
      "layer": "boundary",
      "legal_in_edges": [
        "navigates"
      ],
      "legal_out_edges": [
        "returnsTo",
        "fires",
        "emits"
      ],
      "attrs": {
        "surfaceKind": [
          "osShareSheet",
          "applePaySheet",
          "oauthRedirect",
          "threeDSChallenge",
          "externalApp"
        ],
        "outcome": [
          "success",
          "cancelled",
          "failed"
        ]
      }
    },
    "x-ext:PermissionGate": {
      "kind": "x-ext:PermissionGate",
      "layer": "boundary",
      "legal_in_edges": [
        "navigates",
        "fires"
      ],
      "legal_out_edges": [
        "returnsTo",
        "fires",
        "emits"
      ],
      "attrs": {
        "outcome": [
          "granted",
          "denied",
          "limited"
        ],
        "persistent": true,
        "rePromptable": true
      }
    }
  },
  "edgeRegistry": {
    "x-pipeline:feeds": {
      "ns": "x-pipeline",
      "from_kinds": [
        "PipelineStage"
      ],
      "to_kinds": [
        "PipelineStage"
      ],
      "family": "PIPELINE",
      "subPropertyOf": "invokes",
      "attrs": {
        "transport": [
          "enqueue",
          "inline"
        ]
      }
    },
    "x-pipeline:consumes": {
      "ns": "x-pipeline",
      "from_kinds": [
        "StateStore"
      ],
      "to_kinds": [
        "PipelineStage"
      ],
      "family": "QUERY",
      "subPropertyOf": "reads",
      "attrs": {}
    },
    "x-behavior:reconciles": {
      "ns": "x-behavior",
      "from_kinds": [
        "BackendOp"
      ],
      "to_kinds": [
        "StateStore"
      ],
      "family": "COMMAND",
      "subPropertyOf": "writes",
      "attrs": {
        "onFailure": [
          "rollback",
          "retain",
          "escalate"
        ]
      }
    },
    "x-ext:returnsTo": {
      "ns": "x-ext",
      "from_kinds": [
        "x-ext:ExternalSurface",
        "x-ext:PermissionGate"
      ],
      "to_kinds": [
        "Screen",
        "NavContainer"
      ],
      "family": "NAV",
      "subPropertyOf": "navigates",
      "attrs": {
        "when": "<outcome-value|\"else\">",
        "writesBack": "<StateStore.key>"
      }
    }
  },
  "attrEnumRegistry": {
    "handles.event": [
      "x-rt:socketMessage"
    ]
  },
  "nodeKinds": {
    "surface": [
      "Screen",
      "Component",
      "NavContainer"
    ],
    "logic": [
      "Trigger",
      "NavAction",
      "MutationAction",
      "EffectAction",
      "ViewStateAction",
      "QueryAction",
      "ViewState",
      "Assertion"
    ],
    "substrate": [
      "StateStore",
      "DataSource",
      "BackendOp",
      "PipelineStage",
      "SideEffect"
    ],
    "policy": [
      "Policy"
    ],
    "boundary": [
      "x-ext:ExternalSurface",
      "x-ext:PermissionGate"
    ]
  },
